<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#050505"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="40dp">

        <!-- TOP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MATCH"
                android:textColor="#F2B92B"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/gold_box"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•••"
                android:textColor="#E7AF27"
                android:textSize="27sp"/>
        </LinearLayout>


        <!-- VERSION -->
        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            android:text="v1.6.1(64Bit)-v56.28.2(64Bit) (Match)"
            android:textColor="#F4EBD5"
            android:textSize="17sp"
            android:gravity="center"
            android:padding="12dp"/>


        <!-- USERNAME -->
        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="42dp"
            android:hint="Username"
            android:textColor="#FFFFFF"
            android:textColorHint="#D8A62A"
            android:textSize="18sp"
            android:singleLine="true"
            android:background="@drawable/input_gold"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:inputType="text"
            android:imeOptions="actionNext"/>


        <!-- PASSWORD -->
        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="24dp"
            android:hint="Password"
            android:textColor="#FFFFFF"
            android:textColorHint="#D8A62A"
            android:textSize="18sp"
            android:singleLine="true"
            android:background="@drawable/input_gold"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:inputType="textPassword"
            android:imeOptions="actionDone"/>


        <!-- LOGIN -->
        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="35dp"
            android:text="🚀  LOGIN NOW  ➜"
            android:textColor="#F4C13A"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/button_gold"/>


        <!-- SWITCH -->
        <Button
            android:id="@+id/switchButton"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="18dp"
            android:text="⇄  Switch to FLOGIN"
            android:textColor="#E7AF27"
            android:textSize="17sp"
            android:textAllCaps="false"
            android:background="@drawable/button_dark"/>


        <!-- COPY DEVICE -->
        <Button
            android:id="@+id/copyButton"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="14dp"
            android:text="📱  Copy My Device Info  📋"
            android:textColor="#E7AF27"
            android:textSize="17sp"
            android:textAllCaps="false"
            android:background="@drawable/button_dark"/>


        <!-- REGISTER -->
        <Button
            android:id="@+id/registerButton"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="38dp"
            android:text="🔑  Register and Activate For SubKey"
            android:textColor="#E7AF27"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:background="@drawable/button_dark"/>


        <!-- REACTIVATE -->
        <Button
            android:id="@+id/reactivateButton"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="14dp"
            android:text="⟳  Reactivate Device"
            android:textColor="#E7AF27"
            android:textSize="17sp"
            android:textAllCaps="false"
            android:background="@drawable/button_dark"/>

    </LinearLayout>

</ScrollView>
