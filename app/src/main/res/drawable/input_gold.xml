<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">

        <shape>

            <solid android:color="#090909"/>

            <stroke
                android:width="2dp"
                android:color="#F5BE32"/>

            <corners android:radius="12dp"/>

            <padding
                android:left="4dp"
                android:right="4dp"
                android:top="2dp"
                android:bottom="2dp"/>

        </shape>

    </item>

    <item>

        <shape>

            <solid android:color="#080808"/>

            <stroke
                android:width="1dp"
                android:color="#72500F"/>

            <corners android:radius="12dp"/>

        </shape>

    </item>

</selector>
